  m_TableData:
  - m_Id: 477120024576
    m_Localized: "Ich h\xE4tte nie gedacht, dass meine Reise nach Mada'in Saleh...
      mich hierher f\xFChren w\xFCrde."
    m_Metadata:
      m_Items: []
  - m_Id: 580698361856
    m_Localized: "Alle Gr\xE4ber waren leer."
    m_Metadata:
      m_Items: []
  - m_Id: 616366723072
    m_Localized: "...au\xDFer diesem hier."
    m_Metadata:
      m_Items: []
  - m_Id: 636637794304
    m_Localized: Aber... etwas hat dort auf mich gewartet.
    m_Metadata:
      m_Items: []
  - m_Id: 667696615424
    m_Localized: Und nun...
    m_Metadata:
      m_Items: []
  - m_Id: 689460858880
    m_Localized: ...bin ich hier gefangen.
    m_Metadata:
      m_Items: []
  - m_Id: 724982419456
    m_Localized: Wer... hat das Siegel erweckt?
    m_Metadata:
      m_Items: []
  - m_Id: 744246857728
    m_Localized: ...Wer bist du?
    m_Metadata:
      m_Items: []
  - m_Id: 767114203136
    m_Localized: Man nennt mich... Wahaj.
    m_Metadata:
      m_Items: []
  - m_Id: 786496081920
    m_Localized: "...W\xE4chterin des Spiegels."
    m_Metadata:
      m_Items: []
  - m_Id: 805114597376
    m_Localized: "...Ich sehe, es hat dich auserw\xE4hlt."
    m_Metadata:
      m_Items: []
  - m_Id: 827671564288
    m_Localized: Eines der Tore ist erwacht... lass uns gehen.
    m_Metadata:
      m_Items: []
  - m_Id: 9435209650176
    m_Localized: ' '
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
