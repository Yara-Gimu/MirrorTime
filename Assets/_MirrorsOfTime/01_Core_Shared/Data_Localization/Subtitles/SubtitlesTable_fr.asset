  m_TableData:
  - m_Id: 477120024576
    m_Localized: "Je ne pensais pas que mon voyage \xE0 Mada'in Saleh... me m\xE8nerait
      ici."
    m_Metadata:
      m_Items: []
  - m_Id: 580698361856
    m_Localized: "Toutes les tombes \xE9taient vides."
    m_Metadata:
      m_Items: []
  - m_Id: 616366723072
    m_Localized: ...sauf celle-ci.
    m_Metadata:
      m_Items: []
  - m_Id: 636637794304
    m_Localized: "Mais... quelque chose m'attendait l\xE0-bas."
    m_Metadata:
      m_Items: []
  - m_Id: 667696615424
    m_Localized: Et maintenant...
    m_Metadata:
      m_Items: []
  - m_Id: 689460858880
    m_Localized: "...je suis coinc\xE9e ici."
    m_Metadata:
      m_Items: []
  - m_Id: 724982419456
    m_Localized: "Qui... a \xE9veill\xE9 le sceau ?"
    m_Metadata:
      m_Items: []
  - m_Id: 744246857728
    m_Localized: ...Qui es-tu ?
    m_Metadata:
      m_Items: []
  - m_Id: 767114203136
    m_Localized: On m'appelle... Wahaj.
    m_Metadata:
      m_Items: []
  - m_Id: 786496081920
    m_Localized: ...Gardienne du Miroir.
    m_Metadata:
      m_Items: []
  - m_Id: 805114597376
    m_Localized: ...Je vois qu'il t'a choisie.
    m_Metadata:
      m_Items: []
  - m_Id: 827671564288
    m_Localized: "L'une des portes s'est \xE9veill\xE9e... allons-y."
    m_Metadata:
      m_Items: []
  - m_Id: 9435209650176
    m_Localized: ' '
    m_Metadata:
      m_Items: []
