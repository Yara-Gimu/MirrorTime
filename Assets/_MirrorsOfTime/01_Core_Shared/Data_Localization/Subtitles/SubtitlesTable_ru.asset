  m_SharedData: {fileID: 11400000, guid: e0d730566caf14b4fb9298c4121a9d74, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6742177569951744
    m_Localized: "...\u041E\u043D\u0430 \u0431\u044B\u043B\u0430 \u043A\u0430\u0440\u0442\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 6742172834582528
    m_Localized: "\u042D\u0442\u0438 \u043C\u0435\u0441\u0442\u0430 \u0432\u0441\u0451
      \u0435\u0449\u0435 \u043F\u043E\u043C\u043D\u044F\u0442... \u0438 \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044C
      \u043D\u0435 \u0431\u044B\u043B\u0430 \u043C\u0438\u0444\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 6742149170319360
    m_Localized: "...\u041D\u043E \u0410\u043A\u0430\u0434\u0435\u043C\u0438\u044F
      \u043E\u0448\u0438\u0431\u0430\u043B\u0430\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6742115204845568
    m_Localized: "\u0410 \u0442\u0430 \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044C
      \u2014 \u043F\u0440\u043E\u0441\u0442\u043E \u043C\u0438\u0444."
    m_Metadata:
      m_Items: []
  - m_Id: 6742080794775552
    m_Localized: "\u0413\u043E\u0432\u043E\u0440\u0438\u0442 \u041D\u0430\u0432\u0430\u0440...
      \u0413\u043E\u0434\u0430\u043C\u0438, \u043A\u0430\u043A \u0430\u0440\u0445\u0435\u043E\u043B\u043E\u0433\u0443,
      \u043C\u043D\u0435 \u0442\u0432\u0435\u0440\u0434\u0438\u043B\u0438, \u0447\u0442\u043E
      \u044D\u0442\u0438 \u043C\u0435\u0441\u0442\u0430 \u2014 \u043B\u0438\u0448\u044C
      \u043C\u0435\u0440\u0442\u0432\u044B\u0435 \u0440\u0443\u0438\u043D\u044B..."
    m_Metadata:
      m_Items: []
  - m_Id: 6742053976395776
    m_Localized: "\u0410\u0443\u0434\u0438\u043E\u0434\u043D\u0435\u0432\u043D\u0438\u043A...
      \u0414\u0435\u043D\u044C \u0442\u0440\u0435\u0442\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 724982419456
    m_Localized: "\u041A\u0442\u043E... \u043F\u0440\u043E\u0431\u0443\u0434\u0438\u043B
      \u043F\u0435\u0447\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 744246857728
    m_Localized: "...\u041A\u0442\u043E \u0442\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 767114203136
    m_Localized: "\u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442... \u0412\u0430\u0445\u0430\u0434\u0436."
    m_Metadata:
      m_Items: []
  - m_Id: 786496081920
    m_Localized: "...W\xE4chterin des Spiegels."
    m_Metadata:
      m_Items: []
  - m_Id: 805114597376
    m_Localized: "...\u042F \u0432\u0438\u0436\u0443, \u043E\u043D\u043E \u0432\u044B\u0431\u0440\u0430\u043B\u043E
      \u0442\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 827671564288
    m_Localized: "\u0412\u0440\u0430\u0442\u0430 \u043F\u0440\u043E\u0431\u0443\u0434\u0438\u043B\u0438\u0441\u044C...
      \u0438\u0434\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 9435209650176
    m_Localized: ' '
    m_Metadata:
      m_Items: []
  - m_Id: 7688499558993920
    m_Localized: "\u041D\u0430\u043F\u0438\u0441\u0430\u043D\u043E \u0441\u043D\u0438\u0437\u0443
      \u0432\u0432\u0435\u0440\u0445... \xAB\u041E\u0442 \u041D\u0430\u0442\u044B\xBB.
      \u0421\u043B\u043E\u0432\u043D\u043E \u043E\u043D \u0441\u043F\u0435\u0448\u0438\u043B,
      \u043D\u043E \u043D\u0435 \u0437\u0430\u0445\u043E\u0442\u0435\u043B \u0443\u0439\u0442\u0438,
      \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u0432 \u0441\u043B\u0435\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7688884822593536
    m_Localized: "\u0421\u0430\u0431\u0438\u0433 \u0431\u0438\u043D \u0425\u0430\u0440\u0431\u0430...
      \u041F\u043E\u0445\u043E\u0436\u0435, \u043E\u043D \u0445\u043E\u0442\u0435\u043B,
      \u0447\u0442\u043E\u0431\u044B \u0435\u0433\u043E \u0438\u043C\u044F \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438.
      \u0414\u0430\u0436\u0435 \u0435\u0433\u043E \u0438\u043C\u044F \u0438\u0437\u043B\u0443\u0447\u0430\u0435\u0442
      \u0441\u0438\u043B\u0443, \u0441\u043B\u043E\u0432\u043D\u043E \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435
      \u0442\u0435\u043C, \u043A\u0442\u043E \u043F\u0440\u0438\u0434\u0435\u0442
      \u043F\u043E\u0441\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 7689553726001152
    m_Localized: "\u042D\u0442\u0438 \u0441\u043B\u043E\u0432\u0430 \u2014 \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043F\u0440\u043E\u0441\u0442\u043E \u043C\u043E\u043B\u0438\u0442\u0432\u0430...
      \u0410\u0432\u0442\u043E\u0440 \u0431\u044B\u043B \u0432 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0439
      \u0431\u0435\u0434\u0435. \u041E\u043D \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u0437\u0434\u0435\u0441\u044C \u043F\u0440\u0438\u0437\u044B\u0432 \u043A
      \u043D\u0435\u0431\u0435\u0441\u0430\u043C \u0432 \u043D\u0430\u0434\u0435\u0436\u0434\u0435,
      \u0447\u0442\u043E \u043A\u0442\u043E-\u0442\u043E \u0443\u0441\u043B\u044B\u0448\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 7690195274158080
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u043E \u043E\u0441\u043E\u0437\u043D\u0430\u0432\u0430\u0442\u044C,
      \u0447\u0442\u043E \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0430
      \u043D\u0435\u043F\u043E\u0434\u0432\u043B\u0430\u0441\u0442\u043D\u044B \u0432\u0440\u0435\u043C\u0435\u043D\u0438...
      \u041A\u0442\u043E-\u0442\u043E \u0443\u043C\u043E\u043B\u044F\u043B \u043D\u0435\u0431\u0435\u0441\u0430
      \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A
      \u0443\u0448\u0435\u043B \u0421\u0430\u043B\u0438\u043C. \u041C\u0443\u0436
      \u044D\u0442\u043E \u0431\u044B\u043B \u0438\u043B\u0438 \u0432\u043E\u0437\u043B\u044E\u0431\u043B\u0435\u043D\u043D\u044B\u0439
      \u2014 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E, \u043D\u043E
      \u043F\u0435\u0447\u0430\u043B\u044C \u0441\u043A\u0432\u043E\u0437\u0438\u0442
      \u0432 \u043A\u0430\u0436\u0434\u043E\u0439 \u0431\u0443\u043A\u0432\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 7690467144749056
    m_Localized: "\u0417\u0430\u0441\u0443\u0445\u0430 \u0437\u0434\u0435\u0441\u044C,
      \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C, \u0431\u044B\u043B\u0430
      \u0431\u0435\u0437\u0436\u0430\u043B\u043E\u0441\u0442\u043D\u043E\u0439. \u041A\u043E\u0433\u0434\u0430
      \u043B\u044E\u0434\u0438 \u043C\u043E\u043B\u044F\u0442 \u0441\u0432\u043E\u0438\u0445
      \u0431\u043E\u0433\u043E\u0432 \u043E \u0434\u043E\u0436\u0434\u0435, \u044D\u0442\u043E
      \u0437\u043D\u0430\u0447\u0438\u0442, \u0447\u0442\u043E \u0437\u0435\u043C\u043B\u044F
      \u0434\u043E\u0432\u0435\u0434\u0435\u043D\u0430 \u0434\u043E \u043F\u0440\u0435\u0434\u0435\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7690698187984896
    m_Localized: "\u0412\u043E\u043F\u0440\u0435\u043A\u0438 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F\u043C,
      \u0430\u0432\u0442\u043E\u0440 \u043D\u0435 \u0441\u0442\u0430\u043B \u0441\u043A\u0440\u044B\u0432\u0430\u0442\u044C
      \u0441\u0432\u043E\u0438\u0445 \u043B\u0438\u0447\u043D\u044B\u0445 \u0436\u0435\u043B\u0430\u043D\u0438\u0439.
      \u041E\u043D \u043E\u0442\u043A\u0440\u043E\u0432\u0435\u043D\u043D\u043E \u0432\u044B\u0441\u0435\u043A
      \u0438\u0445 \u043D\u0430 \u043A\u0430\u043C\u043D\u0435, \u043E\u0441\u0442\u0430\u0432\u0438\u0432
      \u0432 \u0432\u0435\u0447\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 7690894959562752
    m_Localized: "\u041F\u043E\u0445\u043E\u0436\u0435, \u0430\u0432\u0442\u043E\u0440
      \u043F\u043E\u043A\u0438\u043D\u0443\u043B \u043A\u043E\u0447\u0435\u0432\u0443\u044E
      \u0436\u0438\u0437\u043D\u044C \u0438\u0437-\u0437\u0430 \u043D\u0438\u0449\u0435\u0442\u044B.
      \u042D\u0442\u0430 \u043D\u0430\u0434\u043F\u0438\u0441\u044C \u043D\u0430\u043C\u0435\u043A\u0430\u0435\u0442,
      \u0447\u0442\u043E \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u0430\u043C\u0443\u0434\u044F\u043D\u0435
      \u043F\u0435\u0440\u0435\u0441\u0435\u043B\u044F\u043B\u0438\u0441\u044C \u0432
      \u0433\u043E\u0440\u043E\u0434\u0430 \u0432 \u043F\u043E\u0438\u0441\u043A\u0430\u0445
      \u043B\u0443\u0447\u0448\u0435\u0439 \u0434\u043E\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 7691127919595520
    m_Localized: "\u0415\u0449\u0435 \u043E\u0434\u043D\u0430 \u043D\u0430\u0434\u043F\u0438\u0441\u044C,
      \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0443\u044E\u0449\u0430\u044F
      \u043E \u0442\u043E\u043C \u0436\u0435 \u0440\u0430\u0437\u0431\u0438\u0442\u043E\u043C
      \u0441\u0435\u0440\u0434\u0446\u0435... \xAB\u0421\u0430\u043B\u0438\u043C
      \u0443\u0448\u0435\u043B\xBB. \u041F\u043E\u0445\u043E\u0436\u0435, \u0435\u0435
      \u0438\u0441\u0442\u043E\u0440\u0438\u044F \u0431\u044B\u043B\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430
      \u0432\u0441\u0435\u043C, \u0438\u043B\u0438, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u043E\u043D\u0430 \u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C,
      \u0447\u0442\u043E\u0431\u044B \u0441\u043D\u043E\u0432\u0430 \u0432\u044B\u0441\u0435\u0447\u044C
      \u0441\u0432\u043E\u044E \u0431\u043E\u043B\u044C \u0432 \u0434\u0440\u0443\u0433\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 7691387874168832
    m_Localized: "\u041E\u043D \u0438\u0441\u043A\u0430\u043B \u0443\u0434\u0430\u0447\u0443,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043D\u0435 \u0441\u043E\u043A\u0440\u0443\u0448\u0438\u0442
      \u0432\u0440\u0435\u043C\u044F. \u041F\u043E\u0440\u043E\u0439 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0439
      \u0444\u0440\u0430\u0437\u044B \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C,
      \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u044F\u0436\u0435\u043B\u0430
      \u0431\u044B\u043B\u0430 \u043D\u043E\u0448\u0430 \u0435\u0435 \u0430\u0432\u0442\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7691536629354496
    m_Localized: "\u041D\u0430\u0434\u043F\u0438\u0441\u044C \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u044B, \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0435
      \u043D\u0430 \u0445\u043E\u043B\u043C\u0435 \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0435\u043A\u0443.
      \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043C\u0435\u0441\u0442\u043E
      \u0431\u044B\u043B\u043E \u0432\u044B\u0431\u0440\u0430\u043D\u043E \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u0438 \u0432\u0441\u0435\u0433\u0434\u0430
      \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0438\u0441\u044C \u043D\u0430 \u0432\u0438\u0434\u0443
      \u0443 \u0436\u0438\u0432\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 7691845879582720
    m_Localized: "\xAB\u0414\u043B\u044F \u0412\u0430\u0445\u0430\u0431 \u0418\u043B\u044F\xBB...
      \u041E\u0447\u0435\u043D\u044C \u043A\u0440\u0430\u0442\u043A\u0430\u044F \u043D\u0430\u0434\u043F\u0438\u0441\u044C.
      \u041F\u0440\u043E\u0441\u0442\u043E \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0445\u043E\u0442\u0435\u043B \u0441\u0432\u044F\u0437\u0430\u0442\u044C \u0441\u0432\u043E\u0435
      \u0438\u043C\u044F \u0441 \u0431\u043E\u0433\u0430\u043C\u0438, \u0447\u0442\u043E\u0431\u044B
      \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u043F\u043E\u0434 \u0438\u0445
      \u0437\u0430\u0449\u0438\u0442\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 7692042076540928
    m_Localized: "\xAB\u041E\u0442 \u041C\u0443\u043A\u0438\u043C\u0430\xBB... \u042D\u0442\u043E
      \u0438\u043C\u044F \u0431\u044B\u043B\u043E \u0432\u044B\u0441\u0435\u0447\u0435\u043D\u043E
      \u0437\u0434\u0435\u0441\u044C \u043F\u043E \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u0438.
      \u0418\u043D\u043E\u0433\u0434\u0430 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435,
      \u0447\u0435\u0433\u043E \u0438\u0449\u0435\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u2014 \u044D\u0442\u043E \u0447\u0442\u043E\u0431\u044B \u0435\u0433\u043E
      \u043D\u0435 \u0437\u0430\u0431\u044B\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 7692306187669504
    m_Localized: "\u042D\u0442\u0430 \u043D\u0430\u0434\u043F\u0438\u0441\u044C \u0438\u043C\u0435\u0435\u0442
      \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435...
      \u041E\u043D\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043D\u0430\u043C,
      \u0447\u0442\u043E \u0436\u0438\u0442\u0435\u043B\u0438 \u044D\u0442\u043E\u0439
      \u0437\u0435\u043C\u043B\u0438 \u0431\u044B\u043B\u0438 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0430\u043C\u0438; \u043C\u043D\u043E\u0433\u043E
      \u0432\u0435\u043A\u043E\u0432 \u043D\u0430\u0437\u0430\u0434 \u043E\u043D\u0438
      \u0442\u0430\u043A\u0436\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0438\u0441\u044C
      \u0437\u0435\u043C\u043B\u0435\u0434\u0435\u043B\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 7692505362583552
    m_Localized: "\u041D\u0435 \u0432\u0441\u0435, \u0447\u0442\u043E \u0432\u044B\u0441\u0435\u0447\u0435\u043D\u043E
      \u043D\u0430 \u043A\u0430\u043C\u043D\u0435, \u043D\u0435\u0441\u0435\u0442
      \u0432\u0435\u043B\u0438\u043A\u0438\u0439 \u0441\u043C\u044B\u0441\u043B...
      \u041F\u043E\u0445\u043E\u0436\u0435, \u044D\u0442\u0430 \u043D\u0430\u0434\u043F\u0438\u0441\u044C
      \u2014 \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u0441\u043C\u0435\u0448\u043A\u0430
      \u043D\u0430\u0434 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C \u043F\u043E
      \u0438\u043C\u0435\u043D\u0438 \u0428\u0430\u0440\u0430\u0444. \u041B\u044E\u0434\u0438
      \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435 \u043D\u0435
      \u0442\u0430\u043A \u0443\u0436 \u0441\u0438\u043B\u044C\u043D\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 7692696350216192
    m_Localized: "\xAB\u0425\u0430\u0434\u0436\u0430\u0434\u0436\xBB \u2014 \u0434\u0440\u0435\u0432\u043D\u0435\u0435
      \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0435 \u0438\u043C\u044F.
      \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0435\u0433\u043E \u043D\u0430\u0437\u0432\u0430\u043B\u0438
      \u0442\u0430\u043A, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E
      \u043E\u043D \u0440\u043E\u0434\u0438\u043B\u0441\u044F \u0432\u043E \u0432\u0440\u0435\u043C\u044F
      \u0441\u0435\u0437\u043E\u043D\u0430 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u0430
      \u0438\u043B\u0438 \u0432\u0430\u0436\u043D\u043E\u0433\u043E \u0440\u0435\u043B\u0438\u0433\u0438\u043E\u0437\u043D\u043E\u0433\u043E
      \u0441\u043E\u0431\u044B\u0442\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 7692927041130496
    m_Localized: "\xAB\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F
      \u043E\u0442 \u0421\u0430\u0434\u0430 \u0438 \u0410\u043B\u0438\xBB... \u041D\u0430\u0434\u043F\u0438\u0441\u044C,
      \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u044F\u044E\u0449\u0430\u044F \u0434\u0432\u0443\u0445
      \u0431\u0440\u0430\u0442\u044C\u0435\u0432. \u041F\u0440\u0438\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
      \u0447\u0442\u043E \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043D\u0438\u043C\u0438
      \u0443\u043F\u043E\u043C\u044F\u043D\u0443\u0442\u0430 \u0438\u0445 \u043C\u0430\u0442\u044C,
      \xAB\u041D\u0438\u043C\u0430\xBB; \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u043E\u043D\u0430 \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0430 \u0432\u044B\u0441\u043E\u043A\u043E\u0435
      \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0438\u043B\u0438 \u0431\u044B\u043B\u0430
      \u043E\u0447\u0435\u043D\u044C \u043B\u044E\u0431\u0438\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7693144008282112
    m_Localized: "\xAB\u041E\u0442 \u0420\u0430\u0430\u0431\u0430 \u0431\u0438\u043D
      \u0414\u0436\u0430\u043C\u0430\u043C\u0430\xBB... \u041F\u0440\u043E\u0441\u0442\u043E
      \u0442\u0438\u0445\u043E \u0432\u044B\u0441\u0435\u0447\u0435\u043D\u043D\u043E\u0435
      \u0438\u043C\u044F. \u041A\u0442\u043E \u0437\u043D\u0430\u0435\u0442, \u043A\u0430\u043A\u0443\u044E
      \u0436\u0438\u0437\u043D\u044C \u043F\u0440\u043E\u0436\u0438\u043B \u044D\u0442\u043E\u0442
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u0441\u0442\u0430\u0442\u044C \u0431\u0435\u0437\u043C\u043E\u043B\u0432\u043D\u043E\u0439
      \u043F\u0430\u043C\u044F\u0442\u044C\u044E \u043D\u0430 \u044D\u0442\u043E\u0439
      \u0441\u0442\u0435\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 7693346932903936
    m_Localized: "\u0412\u043B\u0430\u0434\u0435\u043D\u0438\u0435 \u043F\u043E\u0440\u043E\u0434\u0438\u0441\u0442\u043E\u0439
      \u043A\u043E\u0431\u044B\u043B\u043E\u0439 \u0431\u044B\u043B\u043E \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u043E\u043C
      \u0432\u044B\u0441\u043E\u043A\u043E\u0433\u043E \u0441\u0442\u0430\u0442\u0443\u0441\u0430
      \u0438 \u0431\u043E\u0433\u0430\u0442\u0441\u0442\u0432\u0430. \u041F\u043E\u0445\u043E\u0436\u0435,
      \u0430\u0432\u0442\u043E\u0440 \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E
      \u0433\u043E\u0440\u0434\u0438\u043B\u0441\u044F \u0441\u0432\u043E\u0438\u043C
      \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 7693554395762688
    m_Localized: "\xAB\u0414\u0436\u0430\u0431\u0430 \u0431\u0438\u043D \u0410\u0444\xBB...
      \u041E\u0447\u0435\u043D\u044C \u043A\u0440\u0430\u0442\u043A\u0430\u044F \u043D\u0430\u0434\u043F\u0438\u0441\u044C.
      \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0443 \u043D\u0435\u0433\u043E
      \u043D\u0435 \u0431\u044B\u043B\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438
      \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0438\u043B\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0435\u0433\u043E
      \u0438\u043C\u0435\u043D\u0438 \u0431\u044B\u043B\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u0432\u0441\u0435 \u0435\u0433\u043E \u0443\u0437\u043D\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 7693780376473600
    m_Localized: "\xAB\u0410'\u0430 \u0441\u0442\u043E\u044F\u043B \u043D\u0430 \u0441\u0442\u0440\u0430\u0436\u0435\xBB...
      \u042D\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0443\u0432\u0435\u043D\u0438\u0440.
      \u041F\u043E\u0445\u043E\u0436\u0435, \u043A\u0442\u043E-\u0442\u043E \u043D\u0435\u0441
      \u0437\u0434\u0435\u0441\u044C \u043A\u0430\u0440\u0430\u0443\u043B, \u043E\u0441\u0442\u0430\u0432\u0438\u0432
      \u044D\u0442\u043E\u0442 \u0437\u043D\u0430\u043A \u0432 \u043F\u0430\u043C\u044F\u0442\u044C
      \u043E \u0434\u043E\u043B\u0433\u043E\u0439 \u0441\u043C\u0435\u043D\u0435
      \u0432 \u044D\u0442\u043E\u043C \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 7694138188353536
    m_Localized: "\xAB\u041E\u0442 \u0411\u0430\u0441\u0438\u043B\u044F\xBB... \u041E\u043D
      \u0432\u044B\u0431\u0440\u0430\u043B \u0438\u043C\u044F, \u043E\u0442\u0440\u0430\u0436\u0430\u044E\u0449\u0435\u0435
      \u0435\u0433\u043E \u0445\u0440\u0430\u0431\u0440\u043E\u0441\u0442\u044C,
      \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
      \u0432\u044B\u0441\u0435\u0447\u0435\u043D\u043D\u044B\u043C \u043D\u0430 \u043A\u0430\u043C\u043D\u0435
      \u0442\u0430\u043A \u0436\u0435, \u043A\u0430\u043A \u0438 \u0432 \u043F\u0430\u043C\u044F\u0442\u0438
      \u0442\u0435\u0445, \u043A\u0442\u043E \u0435\u0433\u043E \u0437\u043D\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 7694335995924480
    m_Localized: "\u042D\u0442\u0430 \u043D\u0430\u0434\u043F\u0438\u0441\u044C \u0434\u0440\u0443\u0433\u0430\u044F...
      \u041E\u043D\u0430 \u0431\u044B\u043B\u0430 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0430
      \u0434\u043B\u044F \u043E\u043F\u0435\u0447\u0430\u043B\u0435\u043D\u043D\u043E\u0433\u043E
      \u0431\u0440\u0430\u0442\u0430. \u041F\u0440\u043E\u0441\u0442\u0430\u044F
      \u043C\u043E\u043B\u0438\u0442\u0432\u0430, \u043D\u043E \u043E\u043D\u0430
      \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0433\u043B\u0443\u0431\u0438\u043D\u0443
      \u0438\u0445 \u043B\u044E\u0431\u0432\u0438 \u0434\u0440\u0443\u0433 \u043A
      \u0434\u0440\u0443\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 7694353498755072
    m_Localized: "\u0410\u0432\u0442\u043E\u0440 \u044D\u0442\u043E\u0439 \u043D\u0430\u0434\u043F\u0438\u0441\u0438
      \u043D\u0435 \u043F\u0440\u043E\u0441\u0438\u043B \u043D\u0438 \u0431\u043E\u0433\u0430\u0442\u0441\u0442\u0432\u0430,
      \u043D\u0438 \u0441\u043B\u0430\u0432\u044B... \u0412\u0441\u0435, \u0447\u0435\u0433\u043E
      \u043E\u043D \u0445\u043E\u0442\u0435\u043B, \u2014 \u0447\u0442\u043E\u0431\u044B
      \u0435\u0433\u043E \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u043E\u0441\u044C."
    m_Metadata:
