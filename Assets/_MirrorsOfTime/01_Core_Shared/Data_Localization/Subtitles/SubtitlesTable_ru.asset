  m_TableData:
  - m_Id: 477120024576
    m_Localized: "\u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0434\u0443\u043C\u0430\u043B\u0430,
      \u0447\u0442\u043E \u043C\u043E\u0435 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435
      \u0432 \u041C\u0430\u0434\u0430\u0438\u043D-\u0421\u0430\u043B\u0438\u0445...
      \u043F\u0440\u0438\u0432\u0435\u0434\u0435\u0442 \u043C\u0435\u043D\u044F \u0441\u044E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 580698361856
    m_Localized: "\u0412\u0441\u0435 \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u044B
      \u0431\u044B\u043B\u0438 \u043F\u0443\u0441\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 616366723072
    m_Localized: "...\u043A\u0440\u043E\u043C\u0435 \u044D\u0442\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 636637794304
    m_Localized: "\u041D\u043E... \u0442\u0430\u043C \u043C\u0435\u043D\u044F \u0447\u0442\u043E-\u0442\u043E
      \u0436\u0434\u0430\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 667696615424
    m_Localized: "\u0410 \u0442\u0435\u043F\u0435\u0440\u044C..."
    m_Metadata:
      m_Items: []
  - m_Id: 689460858880
    m_Localized: "...\u044F \u0437\u0430\u043F\u0435\u0440\u0442\u0430 \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 724982419456
    m_Localized: "\u041A\u0442\u043E... \u043F\u0440\u043E\u0431\u0443\u0434\u0438\u043B
      \u043F\u0435\u0447\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 744246857728
    m_Localized: "...\u041A\u0442\u043E \u0442\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 767114203136
    m_Localized: "\u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442... \u0412\u0430\u0445\u0430\u0434\u0436."
    m_Metadata:
      m_Items: []
  - m_Id: 786496081920
    m_Localized: "...W\xE4chterin des Spiegels."
    m_Metadata:
      m_Items: []
  - m_Id: 805114597376
    m_Localized: "...\u042F \u0432\u0438\u0436\u0443, \u043E\u043D\u043E \u0432\u044B\u0431\u0440\u0430\u043B\u043E
      \u0442\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 827671564288
    m_Localized: "\u0412\u0440\u0430\u0442\u0430 \u043F\u0440\u043E\u0431\u0443\u0434\u0438\u043B\u0438\u0441\u044C...
      \u0438\u0434\u0435\u043C."
    m_Metadata:
      m_Items: []
