  m_SharedData: {fileID: 11400000, guid: e0d730566caf14b4fb9298c4121a9d74, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 477120024576
    m_Localized: I never thought my journey to Mada'in Saleh... would lead me here.
    m_Metadata:
      m_Items: []
  - m_Id: 580698361856
    m_Localized: All the tombs were empty.
    m_Metadata:
      m_Items: []
  - m_Id: 616366723072
    m_Localized: ...except this one.
    m_Metadata:
      m_Items: []
  - m_Id: 636637794304
    m_Localized: But... something was waiting for me there.
    m_Metadata:
      m_Items: []
  - m_Id: 667696615424
    m_Localized: And now...
    m_Metadata:
      m_Items: []
  - m_Id: 689460858880
    m_Localized: ...I am trapped here.
    m_Metadata:
      m_Items: []
  - m_Id: 724982419456
    m_Localized: Who... awakened the seal?
    m_Metadata:
      m_Items: []
  - m_Id: 744246857728
    m_Localized: ...Who are you?
    m_Metadata:
      m_Items: []
  - m_Id: 767114203136
    m_Localized: They call me... Wahaj.
    m_Metadata:
      m_Items: []
  - m_Id: 786496081920
    m_Localized: ...Guardian of the Mirror.
    m_Metadata:
      m_Items: []
  - m_Id: 805114597376
    m_Localized: ...I see it has chosen you.
    m_Metadata:
      m_Items: []
  - m_Id: 827671564288
    m_Localized: One of the gates has awakened... let's go.
    m_Metadata:
      m_Items: []
  - m_Id: 9435209650176
    m_Localized: ' '
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
